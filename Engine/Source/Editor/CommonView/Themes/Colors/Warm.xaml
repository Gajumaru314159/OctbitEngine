<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:local="clr-namespace:CommonView"
                    >

    <sys:Double x:Key="DisableOpacity">0.5</sys:Double>

    <SolidColorBrush x:Key="Foreground" Color="#0F0F0F"/>
    <SolidColorBrush x:Key="Background" Color="#EDEDE5"/>
    <SolidColorBrush x:Key="Surface" Color="#CCC7A1"/>
    <SolidColorBrush x:Key="Accent" Color="#EFB47C"/>
    <SolidColorBrush x:Key="AccentForeground" Color="#EEEEEE"/>
    <SolidColorBrush x:Key="Field" Color="#D9D9C1"/>
    <SolidColorBrush x:Key="Outline" Color="#DBD9C0"/>
    <SolidColorBrush x:Key="Header" Color="#DCDBBF"/>
    <SolidColorBrush x:Key="Focus" Color="#0F0F0F"/>
    <SolidColorBrush x:Key="MenuBackground" Color="#DCDBBF"/>
    <SolidColorBrush x:Key="Hover" Color="#20000000"/>

</ResourceDictionary>
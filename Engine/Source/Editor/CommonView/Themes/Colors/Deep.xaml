<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:local="clr-namespace:CommonView"
                    >

    <sys:Double x:Key="DisableOpacity">0.5</sys:Double>

    <SolidColorBrush x:Key="Foreground" Color="#F0F5FA"/>
    <SolidColorBrush x:Key="Background" Color="#222639"/>
    <SolidColorBrush x:Key="Surface" Color="#5F527A"/>
    <SolidColorBrush x:Key="Accent" Color="#BB99FF"/>
    <SolidColorBrush x:Key="AccentForeground" Color="#222639"/>
    <SolidColorBrush x:Key="Field" Color="#181B29"/>
    <SolidColorBrush x:Key="Outline" Color="#6699CC"/>
    <SolidColorBrush x:Key="Header" Color="#222639"/>
    <SolidColorBrush x:Key="Focus" Color="#EEEEEE"/>
    <SolidColorBrush x:Key="MenuBackground" Color="#222639"/>
    <SolidColorBrush x:Key="Hover" Color="#20FFFFFF"/>
</ResourceDictionary>
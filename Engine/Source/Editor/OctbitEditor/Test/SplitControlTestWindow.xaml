<Window x:Class="OctbitEditor.Test.SplitControlTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OctbitEditor.Test"
        xmlns:ctrl="clr-namespace:CommonView.Controls;assembly=CommonView"
        mc:Ignorable="d"
        Title="SplitControlTestWindow" Height="450" Width="800">

    <Window.DataContext>
        <local:SplitControlTestWindowVM/>
    </Window.DataContext>
    
    <Window.Resources>
        
        <local:SplitControlTestWindowSelector x:Key="SplitControlTestWindowSelector"/>

        <Style TargetType="GridSplitter" BasedOn="{StaticResource {x:Type GridSplitter}}">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <DataTemplate DataType="local:SplitControlTestWindowVMSample">
            <Border Background="{DynamicResource Background}" SnapsToDevicePixels="True">
                <StackPanel>
                    <TextBlock Text="{Binding Value}" Foreground="{DynamicResource Foreground}" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding Value}" Foreground="{DynamicResource Foreground}"/>
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="local:SplitControlTestWindowVMSample2">
            <Border Background="{DynamicResource Background}" SnapsToDevicePixels="True">
                <StackPanel>
                    <TextBlock Text="{Binding Value}" Foreground="{DynamicResource Outline}" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding Value}" Foreground="{DynamicResource Outline}"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <ctrl:SplitControl ItemsSource="{Binding ItemsSource}"/>
    </Grid>


</Window>

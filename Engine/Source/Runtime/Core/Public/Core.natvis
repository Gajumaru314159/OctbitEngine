<?xml version="1.0" encoding="utf-8"?> 
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">

	<!--String-->
	<Type Name="std::basic_string&lt;char,*&gt;">
		<Intrinsic Name="size" Expression="_Mypair._Myval2._Mysize" />
		<Intrinsic Name="capacity" Expression="_Mypair._Myval2._Myres" />
		<Intrinsic Name="bufSize" Expression="16" />
		<Intrinsic Name="isShortString" Expression="capacity() &lt; bufSize()" />
		<Intrinsic Name="isLongString" Expression="capacity() &gt;= bufSize()" />
		<DisplayString Condition="isShortString()">{_Mypair._Myval2._Bx._Buf,s8}</DisplayString>
		<DisplayString Condition="isLongString()">{_Mypair._Myval2._Bx._Ptr,s8}</DisplayString>
		<StringView Condition="isShortString()">_Mypair._Myval2._Bx._Buf,s8</StringView>
		<StringView Condition="isLongString()">_Mypair._Myval2._Bx._Ptr,s8</StringView>
		<Expand>
			<Item Name="[size]" ExcludeView="simple">size()</Item>
			<Item Name="[capacity]" ExcludeView="simple">capacity()</Item>
			<Item Name="[allocator]" ExcludeView="simple">_Mypair</Item>
			<ArrayItems>
				<Size>_Mypair._Myval2._Mysize</Size>
				<ValuePointer Condition="isShortString()">_Mypair._Myval2._Bx._Buf</ValuePointer>
				<ValuePointer Condition="isLongString()">_Mypair._Myval2._Bx._Ptr</ValuePointer>
			</ArrayItems>
		</Expand>
	</Type>

	<!--String-->
	<Type Name="ob::core::StringBase&lt;char&gt;">
		<DisplayString>{m_str,s8}</DisplayString>
		<StringView>m_str</StringView>
	</Type>
	
	<!--StringView-->
	<Type Name="ob::core::StringViewBase&lt;*&gt;">
		<DisplayString>{m_view,s8}</DisplayString>
		<StringView>m_view</StringView>
	</Type>

	<!--Pimpl-->
	<Type Name="ob::core::Pimpl&lt;*&gt;">
		<DisplayString>value = {*m_impl}</DisplayString>
	</Type>

	<!--MemoryStorageBase-->
	<Type Name="ob::core::MemoryStorageBase&lt;*,*,*&gt;">
		<Expand>
			<Item Name="[constructed]">m_constructed</Item>
			<Item Name="[instance]" Condition="m_constructed">*($T1*)(m_data)</Item>
		</Expand>
		
	</Type>

	<!--Matrix-->
	<Type Name="ob::core::Matrix">
		<DisplayString>[4, 4]</DisplayString>
		<Expand>
			<Synthetic Name="0">
				<DisplayString>({m00} ,{m01} ,{m02} ,{m03})</DisplayString>
			</Synthetic>
			<Synthetic Name="1">
				<DisplayString>({m10} ,{m11} ,{m12} ,{m13})</DisplayString>
			</Synthetic>
			<Synthetic Name="2">
				<DisplayString>({m20} ,{m21} ,{m22} ,{m23})</DisplayString>
			</Synthetic>
			<Synthetic Name="3">
				<DisplayString>({m30} ,{m31} ,{m32} ,{m33})</DisplayString>
			</Synthetic>
			<Synthetic Name="[translation]">
				<DisplayString>({m03} ,{m13} ,{m23})</DisplayString>
			</Synthetic>
		</Expand>
	</Type>


	<!--AnyContainer-->
	<Type Name="ob::core::AnyContainer">
		<Expand>
			<ExpandedItem>m_container,view(AnyContainerHelper)</ExpandedItem>
		</Expand>
	</Type>
	<Type Name="ob::core::AnyContainer::Holder&lt;*&gt;">
		<Expand>
			<Item Name="instance">instance</Item>
		</Expand>
	</Type>
	<Type Name="std::unordered_map&lt;*&gt;" Priority="Low" IncludeView="AnyContainerHelper">
		<AlternativeType Name="std::unordered_multimap&lt;*&gt;" />
		<DisplayString>{_List}</DisplayString>
		<Expand>
			<ExpandedItem>_List,view(AnyContainerHelper)</ExpandedItem>
		</Expand>
	</Type>	
	<Type Name="std::list&lt;std::pair&lt;*,*&gt;,*&gt;" IncludeView="AnyContainerHelper">
		<DisplayString>Test</DisplayString>
		<Expand>
			<LinkedListItems>
				<Size>_Mypair._Myval2._Mysize</Size>
				<HeadPointer>_Mypair._Myval2._Myhead-&gt;_Next</HeadPointer>
				<NextPointer>_Next</NextPointer>
				<ValueNode Name="[{_Myval.first}]">*_Myval.second</ValueNode>
			</LinkedListItems>
		</Expand>
	</Type>


	<Type Name="std::unordered_map&lt;*&gt;" Priority="MediumHigh" ExcludeView="ShowElementsByIndex">
		<AlternativeType Name="std::unordered_multimap&lt;*&gt;" />
		<DisplayString>{_List}</DisplayString>
		<Expand>
			<Item Name="[bucket_count]" IncludeView="detailed">_Maxidx</Item>
			<Item Name="[load_factor]" IncludeView="detailed">((float)_List._Mypair._Myval2._Mysize) / ((float)_Maxidx)</Item>
			<Item Name="[max_load_factor]" IncludeView="detailed">_Traitsobj._Mypair._Myval2._Myval2</Item>
			<Item Name="[hash_function]" ExcludeView="simple">_Traitsobj._Mypair</Item>
			<Item Name="[key_eq]" ExcludeView="simple">_Traitsobj._Mypair._Myval2</Item>
			<Item Name="[allocator]" ExcludeView="simple">_List._Mypair</Item>
			<ExpandedItem>_List,view(MapHelper)</ExpandedItem>
		</Expand>
	</Type>


	<!--Type-->
	<Type Name="ob::core::Type">
		<DisplayString>{m_name.m_view,sb}</DisplayString>
	</Type>


	<!--HandeManager<T>::Handle-->
	<Type Name="ob::core::HandleManager&lt;*&gt;::Handle">
		<DisplayString Condition="m_owner!=nullptr &amp; m_owner->m_nodes[m_index].version == m_version">{*m_owner->m_nodes[m_index].instance}</DisplayString>
		<DisplayString>Empty</DisplayString>

		<Expand>
			<Item Name="[instance]" Condition="m_owner!=nullptr &amp; m_owner->m_nodes[m_index].version == m_version">*m_owner->m_nodes[m_index].instance</Item>

		</Expand>
	</Type>

	<!--ArgumentInfo-->
	<Type Name="ob::core::ArgumentInfo">
		<DisplayString>{type.m_name,sb}    {name,sb}</DisplayString>
	</Type>

	<!--Any-->
	<Type Name="ob::core::Any">
		<DisplayString Condition="m_info">({m_info->type}*)({m_pointer})</DisplayString>
		<DisplayString Condition="!m_info">empty</DisplayString>
	</Type>

	<!--Property-->
	<Type Name="ob::core::Property">
		<DisplayString Condition="m_info">{m_ownerInfo->type}::{m_info->name.m_view._Mydata,s8b}</DisplayString>
		<DisplayString Condition="!m_info">empty</DisplayString>
	</Type>


	<!--IPAddress-->
	<Type Name="ob::core::IPAddress">
		<DisplayString >{(int)a}.{(int)b}.{(int)c}.{(int)d}</DisplayString>
	</Type>

	<!--YesNo-->
	<Type Name="ob::core::YesNo&lt;*&gt;">
		<DisplayString Condition="m_yesNo">Yes</DisplayString>
		<DisplayString Condition="!m_yesNo">No</DisplayString>
	</Type>
	
	<!--FixedVector-->
	<Type Name="ob::core::FixedVector&lt;*,*&gt;">
		<DisplayString>size={m_size}, capacity={0}</DisplayString>
		<Expand>
			<Item Name="[capacity]">0</Item>
			<ArrayItems>
				<Size>m_size</Size>
				<ValuePointer>m_data._Elems</ValuePointer>
			</ArrayItems>
		</Expand>
	</Type>
	
	<Type Name="std::vector&lt;*&gt;">
		<Intrinsic Name="size" Expression="(size_t)(_Mypair._Myval2._Mylast - _Mypair._Myval2._Myfirst)" />
		<Intrinsic Name="capacity" Expression="(size_t)(_Mypair._Myval2._Myend - _Mypair._Myval2._Myfirst)" />
		<DisplayString>{{ size={size()} }}</DisplayString>
		<Expand>
			<Item Name="[capacity]" ExcludeView="simple">capacity()</Item>
			<Item Name="[size]" ExcludeView="simple">size()</Item>
			<Item Name="[allocator]" ExcludeView="simple">_Mypair</Item>
			<ArrayItems>
				<Size>size()</Size>
				<ValuePointer>_Mypair._Myval2._Myfirst</ValuePointer>
			</ArrayItems>
		</Expand>
	</Type>


	<!--Ref-->
	<Type Name="ob::core::Ref&lt;*&gt;">
		<DisplayString Condition="m_ptr==nullptr">null</DisplayString>
		<DisplayString>{*m_ptr}</DisplayString>
		<Expand>
			<ExpandedItem Condition="m_ptr!=nullptr">*m_ptr</ExpandedItem>
		</Expand>
	</Type>
	
	<!-- BitFlags -->
	<Type Name="ob::core::BitFlags&lt;*&gt;">
		<Intrinsic Name="count0" Expression="(value &amp; 0x5555555555555555) + ((value &gt;&gt; 1) &amp; 0x5555555555555555)">
			<Parameter Name="value" Type="uint64_t" />
		</Intrinsic>
		<Intrinsic Name="count1" Expression="(value &amp; 0x3333333333333333) + ((value &gt;&gt; 2) &amp; 0x3333333333333333)">
			<Parameter Name="value" Type="uint64_t" />
		</Intrinsic>
		<Intrinsic Name="count2" Expression="(value &amp; 0x0F0F0F0F0F0F0F0F) + ((value &gt;&gt; 4) &amp; 0x0F0F0F0F0F0F0F0F)">
			<Parameter Name="value" Type="uint64_t" />
		</Intrinsic>
		<Intrinsic Name="count3" Expression="(value &amp; 0x00FF00FF00FF00FF) + ((value &gt;&gt; 8) &amp; 0x00FF00FF00FF00FF)">
			<Parameter Name="value" Type="uint64_t" />
		</Intrinsic>
		<Intrinsic Name="count4" Expression="(value &amp; 0x0000FFFF0000FFFF) + ((value &gt;&gt; 16) &amp; 0x0000FFFF0000FFFF)">
			<Parameter Name="value" Type="uint64_t" />
		</Intrinsic>
		<Intrinsic Name="count5" Expression="(value &amp; 0x00000000FFFFFFFF) + ((value &gt;&gt; 32) &amp; 0x00000000FFFFFFFF)">
			<Parameter Name="value" Type="uint64_t" />
		</Intrinsic>
		
		<Expand>
			<CustomListItems MaxItemsPerView="64">
				<Variable Name="i" InitialValue="0" />

				<Size>count5(count4(count3(count2(count1(count0(m_bits))))))</Size>
				<Exec>i=0</Exec>
				<Loop>
					<If Condition="(m_bits &amp; (1&lt;&lt;i)) != 0">
						<Item>($T1)(1&lt;&lt;i),en</Item>
					</If>
					<Exec>i++</Exec>
				</Loop>
			</CustomListItems>
		</Expand>
	</Type>


	<Type Name="ob::core::MemorySize">
		<DisplayString Condition="1024ull*1024*1024*1024 &lt; size">{size/(1024.0*1024*1024*1024),g} TiB</DisplayString>
		<DisplayString Condition="1024ull*1024*1024 &lt; size">{size/(1024.0*1024*1024),g} GiB</DisplayString>
		<DisplayString Condition="1024ull*1024 &lt; size">{size/(1024.0*1024),g} MiB</DisplayString>
		<DisplayString Condition="1024ull &lt; size">{size/(1024.0),g} KiB</DisplayString>
		<DisplayString>{size} B</DisplayString>

		<Expand>
			<Item Name="B">size</Item>
			<Item Name="KiB">size/(1024.0),g</Item>
			<Item Name="MiB">size/(1024.0*1024),g</Item>
			<Item Name="GiB">size/(1024.0*1024*1024),g</Item>
			<Item Name="TiB">size/(1024.0*1024*1024*1024),g</Item>
			<Item Name="B">size</Item>
			<Item Name="KB">size/(1000.0),g</Item>
			<Item Name="MB">size/(1000.0*1000),g</Item>
			<Item Name="GB">size/(1000.0*1000*1000),g</Item>
			<Item Name="TB">size/(1000.0*1000*1000*1000),g</Item>
		</Expand>
	</Type>
	
</AutoVisualizer>
<Window x:Class="OctbitEngine.View.TextureViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:OctbitEngine.Texture;assembly=OctbitEngineAPI.Texture"
             xmlns:ctrl="clr-namespace:CommonView.Controls;assembly=CommonView"
             mc:Ignorable="d" 
             Foreground="{DynamicResource Foreground}"
             Background="{DynamicResource Background}"
             d:DataContext="{d:DesignInstance Type=local:TextureViewerVM}}"
             d:DesignHeight="450" d:DesignWidth="1000">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--Colorsは0番目に定義してください-->
                <ResourceDictionary Source="/CommonView;component/Themes/Colors/Dark.xaml"/>
                <ResourceDictionary Source="/CommonView;component/Themes/Theme.xaml"/>
                <ResourceDictionary Source="/CommonView;component/Themes/Icons.xaml"/>
                <ResourceDictionary Source="/CommonView;component/Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>

        <Menu DockPanel.Dock="Top">
            <MenuItem Header="ファイル">
                <MenuItem Header="開く"/>
                <MenuItem Header="保存"/>
                <MenuItem Header="名前をつけて保存"/>
            </MenuItem>
            <MenuItem Header="編集">
                <MenuItem Header="元に戻す"/>
                <MenuItem Header="やり直し"/>
            </MenuItem>
            <MenuItem Header="表示">
                <MenuItem Header="ツールバー"/>
                <MenuItem Header="ステータスバー"/>
            </MenuItem>
            <MenuItem Header="ツール">
                <MenuItem Header="設定"/>
            </MenuItem>
        </Menu>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                <Canvas Width="2048" Height="2048" Background="{DynamicResource MenuBackground}">
                    <Image x:Name="m_image"/>
                </Canvas>
            </ScrollViewer>

            <GridSplitter Grid.Column="1" VerticalAlignment="Stretch" HorizontalAlignment="Center" Width="4" Background="{DynamicResource Outline}"/>

            <StackPanel Grid.IsSharedSizeScope="True" Grid.Column="2">
                <TextBlock>
                    2048x2048
                    2731MB
                    RGBA8
                </TextBlock>

                <ctrl:InspectorView Label="LOD" ItemsSource="{Binding Inspectables}" Style="{StaticResource TopLevelInspectorView}"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>

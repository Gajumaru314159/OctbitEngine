<UserControl x:Class="OctbitEngine.View.TextureViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:OctbitEngine.View"
             xmlns:ctrl="clr-namespace:CommonView.Controls;assembly=CommonView"
             mc:Ignorable="d" 
             Foreground="{DynamicResource Foreground}"
             Background="{DynamicResource Background}"
             d:DesignHeight="450" d:DesignWidth="1000">

    <DockPanel>

        <Menu DockPanel.Dock="Top">
            <MenuItem Header="ファイル">
                <MenuItem Header="開く"/>
                <MenuItem Header="保存"/>
                <MenuItem Header="名前をつけて保存"/>
            </MenuItem>
            <MenuItem Header="編集">
                <MenuItem Header="元に戻す"/>
                <MenuItem Header="やり直し"/>
            </MenuItem>
            <MenuItem Header="表示">
                <MenuItem Header="ツールバー"/>
                <MenuItem Header="ステータスバー"/>
            </MenuItem>
            <MenuItem Header="ツール">
                <MenuItem Header="設定"/>
            </MenuItem>
        </Menu>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                <Canvas Width="2048" Height="2048" Background="{DynamicResource MenuBackground}">
                    <Rectangle Width="200" Height="200" Fill="Green"/>
                </Canvas>
            </ScrollViewer>

            <GridSplitter Grid.Column="1" VerticalAlignment="Stretch" HorizontalAlignment="Center" Width="4" Background="{DynamicResource Outline}"/>

            <StackPanel Grid.IsSharedSizeScope="True" Grid.Column="2">
                <TextBlock>
                    2048x2048
                    2731MB
                    RGBA8
                </TextBlock>
                
                <Expander Header="LOD" IsExpanded="True">
                    <ctrl:InspectorView>
                        <ctrl:InspectorItem Label="ミップ全般設定">
                            <TextBox Text="FromTextureGroup"/>
                        </ctrl:InspectorItem>
                        <ctrl:InspectorItem Label="LOD Bias">
                            <TextBox Text="0"/>
                        </ctrl:InspectorItem>
                        <ctrl:InspectorItem Label="Texture Group">
                            <TextBox Text="World"/>
                        </ctrl:InspectorItem>
                        <ctrl:InspectorView Label="詳細設定">
                            <ctrl:InspectorItem Label="Preserve Border">
                                <CheckBox/>
                            </ctrl:InspectorItem>
                            <ctrl:InspectorItem Label="Downscale">
                                <TextBox Text="0.0"/>
                            </ctrl:InspectorItem>
                            <ctrl:InspectorItem Label="Downscale Options">
                                <TextBox Text="Default"/>
                            </ctrl:InspectorItem>
                            <ctrl:InspectorItem Label="Num Cinematic Mip Levels">
                                <TextBox Text="0"/>
                            </ctrl:InspectorItem>
                            <ctrl:InspectorItem Label="Never Stream">
                                <CheckBox/>
                            </ctrl:InspectorItem>
                            <ctrl:InspectorItem Label="Global Force Resident Mip Level">
                                <CheckBox/>
                            </ctrl:InspectorItem>
                        </ctrl:InspectorView>
                    </ctrl:InspectorView>

                </Expander>
                <Expander Header="圧縮" IsExpanded="True">
                    <ctrl:InspectorView>
                        <ctrl:InspectorItem Label="Compress Without Alpha">
                            <CheckBox/>
                        </ctrl:InspectorItem>
                    </ctrl:InspectorView>
                </Expander>
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>

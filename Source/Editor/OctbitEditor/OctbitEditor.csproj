    <None Remove="Resources\Icons\icon.ico" />
    <None Remove="Resources\Icons\icon_design.apd" />
    <None Remove="Resources\Icons\info.png" />
    <None Remove="Resources\Icons\layer.png" />
    <None Remove="Resources\Icons\left.png" />
    <None Remove="Resources\Icons\light.png" />
    <None Remove="Resources\Icons\menu.png" />
    <None Remove="Resources\Icons\move.png" />
    <None Remove="Resources\Icons\Outliner\entity.png" />
    <None Remove="Resources\Icons\Outliner\folder.png" />
    <None Remove="Resources\Icons\Outliner\icon_design.apd" />
    <None Remove="Resources\Icons\pause.png" />
    <None Remove="Resources\Icons\play.png" />
    <None Remove="Resources\Icons\reload.png" />
    <None Remove="Resources\Icons\right.png" />
    <None Remove="Resources\Icons\rotate.png" />
    <None Remove="Resources\Icons\scale.png" />
    <None Remove="Resources\Icons\search.png" />
    <None Remove="Resources\Icons\select.png" />
    <None Remove="Resources\Icons\shading.png" />
    <None Remove="Resources\Icons\snap_move.png" />
    <None Remove="Resources\Icons\snap_rotate.png" />
    <None Remove="Resources\Icons\snap_scale.png" />
    <None Remove="Resources\Icons\step.png" />

<Application x:Class="OctbitEditor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OctbitEditor">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--Colorsは0番目に定義してください-->
                <ResourceDictionary Source="/CommonView;component/Themes/Colors/Dark.xaml"/>
                <ResourceDictionary Source="/CommonView;component/Themes/Theme.xaml"/>
                <ResourceDictionary Source="/CommonView;component/Themes/Icons.xaml"/>
                <ResourceDictionary Source="/CommonView;component/Themes/Controls.xaml"/>
                <ResourceDictionary Source="/CommonView;component/Themes/CustomAvalonDock.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>

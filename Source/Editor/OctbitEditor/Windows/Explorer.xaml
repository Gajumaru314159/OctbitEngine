<UserControl x:Class="OctbitEditor.Explorer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:l="http://schemas.livet-mvvm.net/2011/wpf"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:OctbitEditor"
             xmlns:base="clr-namespace:CommonView;assembly=CommonView"
             xmlns:ms="clr-namespace:System.Windows.Controls;assembly=MultiSelectTreeView"
             DataContextChanged="UserControl_DataContextChanged"
             Focusable="True"
             FocusManager.FocusedElement="{Binding ElementName=Root}"
             Foreground="{DynamicResource Foreground}"
             Background="{DynamicResource Background}"
             mc:Ignorable="d" 
             d:DesignHeight="250" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance local:ExplorerVM}"
             >

    <UserControl.InputBindings>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding CreateFolderCommand}"/>
    </UserControl.InputBindings>

    
    <!--リソース-->
    <UserControl.Resources>

        <base:EnumToVisibilityConverter x:Key="EnumToVisibility"/>

        <!--コンテキストメニュー-->
        <ContextMenu x:Key="ContextMenu" ItemsSource="{Binding MenuItems.Children}">
            <ContextMenu.Resources>
                <Style TargetType="{x:Type MenuItem}">
                    <Setter Property="Command" Value="{Binding Command}" />
                    <Setter Property="Header" Value="{Binding Header}" />
                    <Setter Property="InputGestureText" Value="{Binding Gesture}" />
                    <Setter Property="ItemsSource" Value="{Binding Children}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                            <Setter Property="Template" >
                                <Setter.Value>
                                    <ControlTemplate>
                                        <Separator/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContextMenu.Resources>
        </ContextMenu>

        <!--ツリー定義-->
        <Style TargetType="ms:MultiSelectTreeViewItem" BasedOn="{StaticResource {x:Type ms:MultiSelectTreeViewItem}}">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded.Value}"/>
            <Setter Property="IsSelected" Value="{Binding IsSelected.Value}"/>
        </Style>
        
    </UserControl.Resources>

    
    <!--コンテンツ-->
    <DockPanel x:Name="Root">
        
        <!--ヘッダー-->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Header}" BorderBrush="{DynamicResource Outline}" BorderThickness="0,0,0,1">
            <DockPanel>
                <DockPanel.Resources>
                    <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                        <Setter Property="Width" Value="22"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="Margin" Value="0,0,1,0"/>
                        <Style.Resources>
                            <Style TargetType="Image">
                                <Setter Property="Width" Value="15"/>
                                <Setter Property="Height" Value="Auto"/>
                                <Setter Property="SnapsToDevicePixels" Value="True"/>
                            </Style>
                        </Style.Resources>
                    </Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Width" Value="22"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="Margin" Value="0,0,1,0"/>
                        <Style.Resources>
                            <Style TargetType="Image">
                                <Setter Property="Width" Value="15"/>
                                <Setter Property="Height" Value="Auto"/>
                                <Setter Property="SnapsToDevicePixels" Value="True"/>
                            </Style>
                        </Style.Resources>
                    </Style>
                </DockPanel.Resources>

                <Button DockPanel.Dock="Left" TabIndex="0">
                    <ContentControl Style="{StaticResource LeftArrow}"/>
                </Button>
                <Button DockPanel.Dock="Left" TabIndex="1">
                    <ContentControl Style="{StaticResource RightArrow}"/>
                </Button>
                <Button DockPanel.Dock="Left" TabIndex="2">
                    <ContentControl Style="{StaticResource UpArrow}"/>
                </Button>
                <Button DockPanel.Dock="Left" TabIndex="3">
                    <ContentControl Style="{StaticResource Reload}"/>
                </Button>

                <base:SearchBox DockPanel.Dock="Right" TabIndex="8"/>
                <ToggleButton Content="★" DockPanel.Dock="Right" TabIndex="7"/>
                <ToggleButton Content="◆" DockPanel.Dock="Right" TabIndex="6"/>
                <ToggleButton Content="■" DockPanel.Dock="Right" TabIndex="5"/>

                <TextBox Text="{Binding SelectedFolderPath.Value}" TabIndex="4" Margin="0,0,1,0"/>
            </DockPanel>
        </Border>

        <!--メイン-->
        <Grid DockPanel.Dock="Bottom">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" MinWidth="100"/>
                <ColumnDefinition Width="4*" MinWidth="100"/>
            </Grid.ColumnDefinitions>

            <!--TreeView-->
            <ms:MultiSelectTreeView x:Name="_tree" ItemsSource="{Binding Children,UpdateSourceTrigger=PropertyChanged}" MinWidth="100" ContextMenu="{StaticResource ContextMenu}">
                <ms:MultiSelectTreeView.ItemTemplate>
                    <HierarchicalDataTemplate DataType="local:ExplorerItem" ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{Binding Icon.Value}" Width="15" Margin="3,0"/>
                            <base:EditableTextBlock Text="{Binding Name.Value}"/>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </ms:MultiSelectTreeView.ItemTemplate>
            </ms:MultiSelectTreeView>

            <!--ListView-->
            <DockPanel Grid.Column="2" MinWidth="100" HorizontalAlignment="Stretch">
                
                <!--フッター-->
                <DockPanel Background="{DynamicResource Header}" DockPanel.Dock="Bottom">
                    <ComboBox ItemsSource="{Binding ListViewTypes}" SelectedItem="{Binding SelectedListViewType.Value}" DockPanel.Dock="Right"/>
                    <Slider Value="{Binding IconSize.Value}" Minimum="40" Maximum="100" DockPanel.Dock="Right" Margin="4,0"
                             Visibility="{Binding SelectedListViewType.Value,Converter={StaticResource EnumToVisibility},ConverterParameter=Icon}"/>
                    <TextBlock Text="{Binding SelectionInfo}" VerticalAlignment="Center" Padding="6,0"/>
                </DockPanel>
                
                <!--コンテンツ-->
                <Grid>
                    <!--リストビュー-->
                    <ListBox ItemsSource="{Binding SelectedFolder.Value.Children}" ContextMenu="{StaticResource ContextMenu}" SelectionMode="Extended"
                             Visibility="{Binding SelectedListViewType.Value,Converter={StaticResource EnumToVisibility},ConverterParameter=List}"
                             AllowDrop="True" Drop="Grid_Drop" DragOver="ListBox_DragOver">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectionChanged">
                                <l:LivetCallMethodAction MethodTarget="{Binding}" MethodName="OnSelectionChangedInList"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>

                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="local:ExplorerItem">
                                <StackPanel Orientation="Horizontal" Background="Transparent" ToolTip="{Binding Name.Value}" ToolTipService.InitialShowDelay="0">
                                    <Image Source="{Binding Icon.Value}" Width="15" Margin="3,0"/>
                                    <base:EditableTextBlock Text="{Binding Name.Value}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="IsSelected" Value="{Binding IsSelectedInList.Value}"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <!--アイコンビュー-->
                    <ListBox Padding="1" ItemsSource="{Binding SelectedFolder.Value.Children}" ContextMenu="{StaticResource ContextMenu}"  
                             SelectionMode="Extended" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Visibility="{Binding SelectedListViewType.Value,Converter={StaticResource EnumToVisibility},ConverterParameter=Icon}"
                             AllowDrop="True" Drop="Grid_Drop" DragOver="ListBox_DragOver"
                             >
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectionChanged">
                                <l:LivetCallMethodAction MethodTarget="{Binding}" MethodName="OnSelectionChangedInList"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Margin" Value="4"/>
                                <Setter Property="IsSelected" Value="{Binding IsSelectedInList.Value}"/>
                                <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Cycle"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="local:ExplorerItem">
                                <DockPanel>
                                    <base:EditableTextBlock Text="{Binding Name.Value}" MaxWidth="{Binding DataContext.IconSize.Value,ElementName=Root}" HorizontalAlignment="Center" DockPanel.Dock="Bottom"/>
                                    <Border BorderThickness="1" BorderBrush="{Binding ItemColorBrush}" Background="{DynamicResource Surface}">
                                        <Image Source="{Binding Icon.Value}" 
                                           Width="{Binding DataContext.IconSize.Value,ElementName=Root}" 
                                           Height="{Binding DataContext.IconSize.Value,ElementName=Root}"/>
                                    </Border>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!--詳細ビュー-->
                    <ListView ItemsSource="{Binding SelectedFolder.Value.Children}" SelectionMode="Extended" ContextMenu="{StaticResource ContextMenu}" 
                             Visibility="{Binding SelectedListViewType.Value,Converter={StaticResource EnumToVisibility},ConverterParameter=Detail}"
                              AllowDrop="True" Drop="Grid_Drop" DragOver="ListBox_DragOver"
                              >
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectionChanged">
                                <l:LivetCallMethodAction MethodTarget="{Binding}" MethodName="OnSelectionChangedInList"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                <Setter Property="IsSelected" Value="{Binding IsSelectedInList.Value}"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView AllowsColumnReorder="True">
                                <GridViewColumn Header="名前" Width="300">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <DockPanel>
                                                <Image Source="{Binding Icon.Value}" Width="15" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <base:EditableTextBlock Text="{Binding Name.Value}" VerticalAlignment="Center" Margin="0,-2"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="更新日時" Width="80">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="2024/01/01"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="種類" Width="80">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="Texture"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="サイズ" Width="80">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="12KB"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="作成者" Width="80">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="Gajumaru"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="タグ" Width="Auto">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Border BorderBrush="LimeGreen" BorderThickness="1" CornerRadius="{DynamicResource CornderRadiusA}" Padding="2,0" Margin="0,0,1,0">
                                                    <TextBlock Text="OBSOLATE"/>
                                                </Border>
                                                <Border BorderBrush="DarkOrange" BorderThickness="1" CornerRadius="{DynamicResource CornderRadiusA}" Padding="2,0" Margin="0,0,1,0">
                                                    <TextBlock Text="FIXME"/>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                </Grid>
            </DockPanel>

            <!--Splitter-->
            <GridSplitter Grid.Column="1" Width="8" Margin="-4,0,0,0" HorizontalAlignment="Left" Focusable="False">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="{x:Type GridSplitter}">
                        <Border  Background="Transparent">
                            <Rectangle Fill="{DynamicResource Outline}" Width="1" HorizontalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

        </Grid>
    </DockPanel>
</UserControl>

<UserControl x:Class="OctbitEditor.Inspector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:i="inte"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:ei="http://schemas.microsoft.com/expression/2010/interactions" 
             xmlns:local="clr-namespace:OctbitEditor"
             xmlns:ctrl="clr-namespace:CommonView.Controls;assembly=CommonView"
             xmlns:behavior="clr-namespace:CommonView.Behaviors;assembly=CommonView"
             xmlns:base="clr-namespace:CommonView;assembly=CommonView"
             Background="{DynamicResource Background}"             
             d:DataContext="{d:DesignInstance local:InspectorVM}"
             mc:Ignorable="d" 
             d:DesignWidth="350" d:DesignHeight="450">

    <DockPanel Grid.IsSharedSizeScope="True">

        <base:SearchBox DockPanel.Dock="Top" Width="Auto"/>

        <Button Content="Add Component" DockPanel.Dock="Bottom">
            <Button.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Transform"/>
                    <MenuItem Header="Model"/>
                </ContextMenu>
            </Button.ContextMenu>
        </Button>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <b:Interaction.Behaviors>
                <behavior:ScrollViewerMiddleButtonDragBehavior/>
            </b:Interaction.Behaviors>
            <StackPanel DockPanel.Dock="Top" Grid.IsSharedSizeScope="True">
                <Expander IsExpanded="True" Margin="0,0,0,1">
                    <Expander.Header>
                        <DockPanel>
                            <TextBlock Text="Entity"/>
                        </DockPanel>
                    </Expander.Header>
                    <ctrl:InspectorView Target="{Binding Entity}" />
                </Expander>
                <Expander IsExpanded="True" Margin="0,0,0,1">
                    <Expander.Header>
                        <DockPanel>
                            <ContentControl Style="{StaticResource Hamburger}" DockPanel.Dock="Right" VerticalAlignment="Bottom"/>
                            <TextBlock Text="Transform"/>
                        </DockPanel>
                    </Expander.Header>
                    <ctrl:InspectorView Target="{Binding Transform}" />
                </Expander>
                <Expander IsExpanded="False" Margin="0,0,0,1">
                    <Expander.Header>
                        <DockPanel>
                            <ContentControl Style="{StaticResource Hamburger}" DockPanel.Dock="Right" VerticalAlignment="Bottom"/>
                            <TextBlock Text="Model"/>
                        </DockPanel>
                    </Expander.Header>
                    <ctrl:InspectorView Target="{Binding TestObject}" />
                </Expander>
                <Expander IsExpanded="True" Margin="0,0,0,1">
                    <Expander.Header>
                        <DockPanel>
                            <ContentControl Style="{StaticResource Hamburger}" DockPanel.Dock="Right" VerticalAlignment="Bottom"/>
                            <TextBlock Text="Test"/>
                        </DockPanel>
                    </Expander.Header>
                    <ctrl:InspectorView>
                                                
                        <ctrl:InspectorItemContainer Label="AAA">
                            <TextBox/>
                        </ctrl:InspectorItemContainer>
                        <ctrl:InspectorItemContainer Label="BBB" CollapseLabel="True">
                            <TextBox/>
                        </ctrl:InspectorItemContainer>


                        <ctrl:InspectorItemContainer IsExpanded="{Binding Expanded.Value,Mode=TwoWay,FallbackValue=True}">
                            <ctrl:InspectorItemContainer.Label>
                                <TextBlock Text="Struct" TextAlignment="Left"/>
                            </ctrl:InspectorItemContainer.Label>
                        </ctrl:InspectorItemContainer>


                        <ctrl:InspectorView>

                            <ctrl:InspectorItemContainer IsExpanded="{Binding Expanded.Value,Mode=TwoWay,FallbackValue=True}">
                                <ctrl:InspectorItemContainer.Label>
                                    <TextBlock Text="Struct" TextAlignment="Left"/>
                                </ctrl:InspectorItemContainer.Label>
                            </ctrl:InspectorItemContainer>

                            <ctrl:InspectorView>


                                <ctrl:InspectorItemContainer IsExpanded="True">
                                    <ctrl:InspectorItemContainer.Label>
                                        <TextBlock Text="List" TextAlignment="Left"/>
                                    </ctrl:InspectorItemContainer.Label>
                                </ctrl:InspectorItemContainer>

                                <ctrl:InspectorView>
                                    <ctrl:InspectorItemContainer Label="Size">
                                        <TextBox Text="2"/>
                                    </ctrl:InspectorItemContainer>
                                    <ctrl:InspectorItemContainer Label="[0]">
                                        <CheckBox/>
                                    </ctrl:InspectorItemContainer>
                                    <ctrl:InspectorItemContainer Label="[1]">
                                        <CheckBox/>
                                    </ctrl:InspectorItemContainer>

                                </ctrl:InspectorView>
                            </ctrl:InspectorView>
                        </ctrl:InspectorView>
                        <ctrl:InspectorItemContainer Label="CCC">
                            <TextBox/>
                        </ctrl:InspectorItemContainer>
                        <GroupBox Header="Group">
                            <StackPanel>
                                <TextBox/>
                                <TextBox/>
                                <TextBox/>
                            </StackPanel>
                        </GroupBox>
                    </ctrl:InspectorView>
                </Expander>
            </StackPanel>
        </ScrollViewer>

    </DockPanel>

</UserControl>

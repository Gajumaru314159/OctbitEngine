<UserControl x:Class="OctbitEditor.Inspector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:ei="http://schemas.microsoft.com/expression/2010/interactions" 
             xmlns:local="clr-namespace:OctbitEditor"
             xmlns:ctrl="clr-namespace:CommonView.Controls;assembly=CommonView"
             xmlns:behavior="clr-namespace:CommonView.Behaviors;assembly=CommonView"
             xmlns:base="clr-namespace:CommonView;assembly=CommonView"
             x:Name="_root"
             FocusManager.FocusedElement="{Binding ElementName=_addComponentButton}"
             Background="{DynamicResource Background}"             
             d:DataContext="{d:DesignInstance local:InspectorVM}"
             mc:Ignorable="d" 
             d:DesignWidth="350" d:DesignHeight="450">

    <UserControl.Resources>
        <ContextMenu x:Key="ContentContextMenu">
            <MenuItem Header="コピー"/>
            <MenuItem Header="ペースト"/>
            <MenuItem Header="削除"/>
        </ContextMenu>


        <!--InspectableEntity-->
        <DataTemplate x:Key="InspectableEntity" DataType="local:InspectableEntity">
            <ItemsControl ItemsSource="{Binding Inspectables}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Expander>
                            <Expander.Header>
                                <DockPanel>
                                    <Border Background="Transparent" DockPanel.Dock="Right" Padding="1,0,0,0"
                                                Focusable="True" FocusVisualStyle="{StaticResource FocusVisual}" 
                                                ContextMenu="{StaticResource ContentContextMenu}">
                                        <ContentControl Style="{StaticResource Hamburger}" VerticalAlignment="Bottom"/>
                                    </Border>
                                    <TextBlock Text="{Binding Name}"/>
                                </DockPanel>
                            </Expander.Header>
                            <ctrl:InspectorView ItemsSource="{Binding Inspectables}"/>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>


        <!--InspectableEntity-->
        <DataTemplate x:Key="InspectableTransform" DataType="local:InspectableTransform">
            <StackPanel>
                <StackPanel>
                    <RadioButton Content="World"/>
                    <RadioButton Content="Local"/>
                </StackPanel>
                <ctrl:InspectorView ItemsSource="{Binding Inspectables}"/>
            </StackPanel>
        </DataTemplate>
    
    </UserControl.Resources>

    <i:Interaction.Behaviors>
        <behavior:KeyboardFocusBehavior Target="{Binding ElementName=_searchBox}" InputGesture="F3"/>
    </i:Interaction.Behaviors>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="20"/>
        </Grid.RowDefinitions>
        
        <DockPanel Grid.IsSharedSizeScope="True">

            <base:SearchBox x:Name="_searchBox" Watermark="検索 (F3)" DockPanel.Dock="Top" Margin="1" Text="{Binding Filter.Value}"/>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <b:Interaction.Behaviors>
                    <behavior:ScrollViewerMiddleButtonDragBehavior/>
                </b:Interaction.Behaviors>

                <ItemsControl IsTabStop="False" ItemsSource="{Binding Inspectables}" d:ItemsSource="{d:SampleData ItemCount=3}" AllowDrop="True">
                    <i:Interaction.Behaviors>
                    </i:Interaction.Behaviors>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="local:InspectableGroup">
                            <Expander Margin="0,0,0,1">
                                <Expander.Header>
                                    <DockPanel>
                                        <Border Background="Transparent" DockPanel.Dock="Right" Padding="1,0,0,0"
                                                Focusable="True" FocusVisualStyle="{StaticResource FocusVisual}" 
                                                ContextMenu="{StaticResource ContentContextMenu}">
                                            <ContentControl Style="{StaticResource Hamburger}" VerticalAlignment="Bottom"/>
                                        </Border>
                                        <TextBlock Text="{Binding Name}"/>
                                    </DockPanel>
                                </Expander.Header>
                                <ctrl:InspectorView ItemsSource="{Binding Inspectables}" LabelWidth="{Binding DataContext.SharedLabelWidth.Value,ElementName=_root,Mode=TwoWay}"/>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                
            </ScrollViewer>

        </DockPanel>

        <!--タブナビゲーションの順序がうまく制御できないので一番下で定義-->
        <Button x:Name="_addComponentButton" Content="Add Component" Grid.Row="1">
            <Button.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Transform"/>
                    <MenuItem Header="Model"/>
                </ContextMenu>
            </Button.ContextMenu>
        </Button>
    </Grid>

</UserControl>

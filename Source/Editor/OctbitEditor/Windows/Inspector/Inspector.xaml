                                <ctrl:InspectorItem Label="[0]">
                                    <CheckBox/>
                                </ctrl:InspectorItem>
                                <ctrl:InspectorItem Label="[1]">
                                    <CheckBox/>
                                </ctrl:InspectorItem>
                            </ctrl:InspectorView>

                        </ctrl:InspectorView>
                    </ctrl:InspectorView>
                    <ctrl:InspectorItem Label="CCC">
                        <TextBox/>
                    </ctrl:InspectorItem>
                        
                </ctrl:InspectorView>
                -->
            </ItemsControl>
        </ScrollViewer>

    </DockPanel>

</UserControl>

                                <ContentControl Style="{StaticResource Hamburger}" VerticalAlignment="Bottom"/>
                            </Border>
                            <TextBlock Text="Manual"/>
                        </DockPanel>
                    </ctrl:InspectorView.Label>

                    <ctrl:InspectorItem Label="AAA">
                        <ComboBox/>
                    </ctrl:InspectorItem>
                        
                    <ctrl:InspectorItem Label="BBB">
                        <TextBox/>
                    </ctrl:InspectorItem>

                    <ctrl:InspectorView Label="Struct">

                        <ctrl:InspectorView Label="Manual">

                            <ctrl:InspectorView Label="List">

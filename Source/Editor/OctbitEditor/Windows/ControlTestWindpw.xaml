<Window x:Class="OctbitEditor.Windows.ControlTestWindpw"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OctbitEditor.Windows"
        mc:Ignorable="d" 
        Background="{DynamicResource Background}"
        d:DesignHeight="1000" d:DesignWidth="800">
    <StackPanel IsEnabled="True">
        
        <!--Menu-->
        <Menu>
            <MenuItem Header="File">
                <MenuItem Header="Save">
                    <MenuItem Header="Save As"/>
                </MenuItem>
                <MenuItem Header="AAA" IsCheckable="True" IsChecked="True"/>
                <MenuItem Header="BBB" IsCheckable="True" IsChecked="False"/>
            </MenuItem>
            <MenuItem Header="Edit"/>
            <MenuItem Header="Help"/>
        </Menu>
        
        <!--Button-->
        <StackPanel Orientation="Horizontal">
            <Button Content="Button" ToolTip="ToolTip">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="MenuItem"/>
                        <MenuItem Header="MenuItem"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
            <Button Content="Disabled" IsEnabled="False"/>
        </StackPanel>
        <Border Height="10"/>
        
        <!--RepeatButton-->
        <StackPanel Orientation="Horizontal">
            <RepeatButton Content="RepeatButton"/>
            <RepeatButton Content="Disabled"/>
        </StackPanel>
        <Border Height="10"/>

        <!--ToggleButton-->
        <StackPanel Orientation="Horizontal">
            <ToggleButton Content="Toggle Button" ToolTip="ToolTip"/>
            <ToggleButton Content="Checked" IsChecked="True"/>
            <ToggleButton Content="Disabled" IsEnabled="False"/>
            <ToggleButton Content="Disabled" IsChecked="True" IsEnabled="False"/>
        </StackPanel>
        <Border Height="10"/>
        
        <!--Expander-->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Expander Header="Expander" IsExpanded="True" Grid.Column="0">
                <StackPanel>
                    <Button Content="Button"/>
                </StackPanel>
            </Expander>
            <Expander Header="Expander" IsExpanded="True" Grid.Column="1" IsEnabled="False">
                <StackPanel>
                    <Button Content="Button"/>
                </StackPanel>
            </Expander>
        </Grid>
        <Border Height="10"/>
        
        <!--CheckBox-->
        <StackPanel Orientation="Horizontal">
            <CheckBox Content="CheckBox" IsChecked="True"/>
            <CheckBox Content="CheckBox" IsChecked="{x:Null}"/>
            <CheckBox Content="CheckBox" IsChecked="False"/>
            <CheckBox Content="CheckBox" IsChecked="True" IsEnabled="False"/>
            <CheckBox Content="CheckBox" IsChecked="{x:Null}" IsEnabled="False"/>
            <CheckBox Content="CheckBox" IsChecked="False" IsEnabled="False"/>
        </StackPanel>
        <Border Height="10"/>

        <!--RadioButton-->
        <StackPanel Orientation="Horizontal">
            <RadioButton Content="RadioButton" IsChecked="True"/>
            <RadioButton Content="A" IsChecked="{x:Null}"/>
            <RadioButton Content="B"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
            <StackPanel.Resources>
                <Style TargetType="RadioButton" BasedOn="{StaticResource NoIconRadioButton}"/>
            </StackPanel.Resources>
            <RadioButton Content="RadioButton" IsChecked="True"/>
            <RadioButton Content="A" IsChecked="{x:Null}"/>
            <RadioButton Content="B"/>
        </StackPanel>
        <Border Height="10"/>
        
        <!--ComboBox-->
        <ComboBox SelectedIndex="0">
            <ComboBoxItem Content="Item 1"/>
            <ComboBoxItem Content="Item 2"/>
            <ComboBoxItem Content="Item 3"/>
        </ComboBox>
        <Border Height="10"/>

        <!--Slider-->
        <StackPanel Orientation="Vertical">
            <Slider Minimum="0" Maximum="100" Value="30" TickPlacement="Both" AutoToolTipPlacement="TopLeft"/>
            <Slider Minimum="0" Maximum="100" Value="30" IsEnabled="False"/>
        </StackPanel>
        <Border Height="10"/>

        <!--Tab-->
        <TabControl>
            <TabItem Header="A">
                <Button Content="AA"/>
            </TabItem>
            <TabItem Header="B"/>
            <TabItem Header="C"/>
        </TabControl>
        <Border Height="10"/>

        <!--Label-->
        <StackPanel Orientation="Horizontal">
            <Label Content="Label"/>
            <Label Content="Label" IsEnabled="False"/>
        </StackPanel>
        <Border Height="10"/>

        <!--TextBox-->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBox Text="aaaaa"/>
            <TextBox Text="aaaaa" Grid.Column="1" IsEnabled="False"/>
        </Grid>
        <Border Height="10"/>

        <!--GroupBox-->
        <GroupBox Header="group A">
            <StackPanel >
                <RadioButton Content="AAA"/>
                <RadioButton Content="BBB"/>
            </StackPanel>
        </GroupBox>

        <!--StatusBar ProgressBar-->
        <StatusBar VerticalAlignment="Bottom">
            <ProgressBar Width="100" Height="20" Value="60" Maximum="100" Minimum="0"/>
            <Label Content="60%"/>
            <Separator/>
            <Label Content="処理しています..."/>
            </StatusBar>
        <Border Height="10"/>


        <DataGrid d:ItemsSource="{d:SampleData}" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}"/>
                <DataGridTextColumn Header="Value" Binding="{Binding Value}"/>
            </DataGrid.Columns>
        </DataGrid>
        <Border Height="10"/>

        <ListView d:ItemsSource="{d:SampleData}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="Value" DisplayMemberBinding="{Binding Value}"/>
                </GridView>
            </ListView.View>
        </ListView>
        <Border Height="10"/>

        <ListBox d:ItemsSource="{d:SampleData}"/>
        <Border Height="10"/>

        <TreeView>
            <TreeViewItem Header="Item 1">
                <TreeViewItem Header="Item 1.1"/>
                <TreeViewItem Header="Item 1.2"/>
            </TreeViewItem>
        </TreeView>
        <Border Height="10"/>

        <ToolBarTray>
            <ToolBar>
                <Button Content="Button"/>
                <Button Content="Button"/>
                <Button Content="Button"/>
            </ToolBar>
            <ToolBar>
                <Button Content="A"/>
                <Button Content="B"/>
                <Button Content="C"/>
            </ToolBar>
        </ToolBarTray>
        <Border Height="10"/>

        <RichTextBox>
            <FlowDocument>
                <Paragraph>
                    <Bold>Some bold text in the paragraph.</Bold>
                    Some text that is not bold.
                </Paragraph>
                <List>
                    <ListItem>
                        <Paragraph>ListItem 1</Paragraph>
                    </ListItem>
                    <ListItem>
                        <Paragraph>ListItem 2</Paragraph>
                    </ListItem>
                    <ListItem>
                        <Paragraph>ListItem 3</Paragraph>
                    </ListItem>
                </List>
            </FlowDocument>
        </RichTextBox>
        <Border Height="10"/>
    </StackPanel>
</Window>

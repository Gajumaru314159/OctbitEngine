<Window x:Class="OctbitEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonDock="https://github.com/Dirkster99/AvalonDock"
	    xmlns:shell="clr-namespace:Microsoft.Windows.Shell;assembly=AvalonDock"
        xmlns:local="clr-namespace:OctbitEditor"
        xmlns:v="clr-namespace:CommonView.AvalonDock;assembly=CommonView"
        xmlns:base="clr-namespace:CommonView;assembly=CommonView"
        Foreground="{DynamicResource Foreground}"
        Background="{DynamicResource MenuBackground}"
        Width="1800" Height="1000"
        Loaded="OnLoaded"
        Closing="OnClosing"
        FontSize="{StaticResource SystemFontSize}"
        
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:MainWindowVM}"
    >


    <WindowChrome.WindowChrome>
        <WindowChrome x:Name="chrome" ResizeBorderThickness="2" NonClientFrameEdges="None" />
    </WindowChrome.WindowChrome>
    
    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}"/>
        <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}"/>
    </Window.InputBindings>

    <DockPanel x:Name="Root">

        <DockPanel DockPanel.Dock="Top" Margin="0,5,0,0">

            <!--ボタン-->
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource MinimizeButton}" Click="MinimizeClick" />
                <Button Style="{StaticResource MaximizeButton}" Click="MaximizeClick" />
                <Button Style="{StaticResource RestoreDownButton}" Click="RestoreDownClick" />
                <Button Style="{StaticResource CloseButton}" Click="CloseClick" />
            </StackPanel>
            
            <Image Source="/Resources/Icons/header.png" Height="32" Margin="10,0" VerticalAlignment="Center"/>
            
            <!--メニューバー-->
            <Menu VerticalAlignment="Bottom" Padding="0" WindowChrome.IsHitTestVisibleInChrome="True">
                <MenuItem Header="_File">
                    <MenuItem Header="_New Scene" InputGestureText="Ctrl+N" Command="{Binding NewSceneCommand}"/>
                    <MenuItem Header="_Open Scene" InputGestureText="Ctrl+O"/>
                    <!--<MenuItem Header="Open Recent Scene" ItemsSource="{Binding RecentScenes}"/>-->
                    <Separator/>
                    <MenuItem Header="_Save" InputGestureText="Ctrl+S"/>
                    <MenuItem Header="Save _As..." InputGestureText="Ctrl+Shift+S"/>
                    <Separator/>
                    <MenuItem Header="New Project..."/>
                    <MenuItem Header="Open Project..."/>
                    <MenuItem Header="Save Project..."/>
                    <Separator/>
                    <MenuItem Header="_Exit" Command="{Binding ExitCommand}"/>
                </MenuItem>
                <MenuItem Header="_Edit">
                    <MenuItem Header="Undo" InputGestureText="Ctrl+Z" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}"/>
                    <MenuItem Header="Redo" InputGestureText="Ctrl+Y" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}"/>
                    <MenuItem Header="Undo History" InputGestureText="Ctrl+Y"/>
                    <Separator/>
                    <MenuItem Header="Select All" InputGestureText="Ctrl+A"/>
                    <MenuItem Header="Deselect All" InputGestureText="Ctrl+D"/>
                    <MenuItem Header="Select Children" InputGestureText="Shift+C"/>
                    <MenuItem Header="Select Prefab Root" InputGestureText="Ctrl+Shift+R"/>
                    <Separator/>
                    <MenuItem Header="Cut" InputGestureText="Ctrl+X"/>
                    <MenuItem Header="Copy" InputGestureText="Ctrl+C"/>
                    <MenuItem Header="Paste" InputGestureText="Ctrl+V"/>
                    <Separator/>
                    <MenuItem Header="Duplicate" InputGestureText="Ctrl+D"/>
                    <MenuItem Header="Rename" InputGestureText="F2"/>
                    <MenuItem Header="Delete" InputGestureText="Delete"/>
                    <Separator/>
                    <MenuItem Header="Find" InputGestureText="Ctrl+F"/>
                    <Separator/>
                    <MenuItem Header="Play" InputGestureText="Ctrl+P"/>
                    <MenuItem Header="Pause" InputGestureText="Ctrl+Shift+P"/>
                    <MenuItem Header="Step" InputGestureText="Ctrl+Alt+P"/>
                    <Separator/>
                    <MenuItem Header="Editor Config"/>
                    <MenuItem Header="Runtime Config" IsCheckable="True"/>
                </MenuItem>
                <MenuItem Header="_Assets">
                    <MenuItem Header="New"/>
                </MenuItem>
                <MenuItem Header="_GameObject">
                    <MenuItem Header="New">
                        <MenuItem Header="Empty"/>
                        <MenuItem Header="Model"/>
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="_Component">
                    <MenuItem Header="New"/>
                </MenuItem>
                <MenuItem Header="_Window">
                    <MenuItem Header="New"/>
                </MenuItem>
                <MenuItem Header="_Help">
                    <MenuItem Header="About"/>
                    <Separator/>
                    <MenuItem Header="Manual"/>
                    <MenuItem Header="API Refelence"/>
                    <Separator/>
                    <MenuItem Header="Release Notes"/>
                </MenuItem>
            </Menu>

            <ComboBox VerticalAlignment="Bottom" WindowChrome.IsHitTestVisibleInChrome="True" ItemsSource="{Binding ThemePresets}" SelectedValue="{Binding ThemePreset}" SelectionChanged="OnThemeColorChanged"/>

            <TextBlock Text="{Binding Title.Value}" VerticalAlignment="Bottom" HorizontalAlignment="Center"/>

        </DockPanel>

        <!-- ======== ドッキングエリア ======== -->
        <avalonDock:DockingManager 
            x:Name="_dockingManager"
            DocumentsSource="{Binding DockingDocumentViewModels}"
            AnchorablesSource="{Binding DockingPaneViewModels}">

            <avalonDock:DockingManager.Theme>
                <avalonDock:Vs2013DarkTheme />
            </avalonDock:DockingManager.Theme>
            
            <avalonDock:DockingManager.Style>
                <Style TargetType="{x:Type avalonDock:DockingManager}" BasedOn="{StaticResource {x:Type avalonDock:DockingManager}}">
                    <Setter Property="GridSplitterWidth" Value="3"/>
                    <Setter Property="GridSplitterHeight" Value="3"/>
                    <Setter Property="Background" Value="{DynamicResource MenuBackground}"/>
                </Style>
            </avalonDock:DockingManager.Style>

            <!-- ======== LayoutItem コンテナ (ウィンドウやタブ) のスタイル ======== -->
            <avalonDock:DockingManager.LayoutItemContainerStyleSelector>
                <v:LayoutItemContainerStyleSelector>
                    <!-- Document のスタイル -->
                    <v:LayoutItemTypedStyle DataType="{x:Type local:DocumentBase}">
                        <Style TargetType="{x:Type avalonDock:LayoutItem}">
                            <Setter Property="Title" Value="{Binding Model.Title}" />
                            <Setter Property="ContentId" Value="{Binding Model.ContentId}" />
                        </Style>
                    </v:LayoutItemTypedStyle>
                    <!-- Pane のスタイル -->
                    <v:LayoutItemTypedStyle DataType="{x:Type local:TabBase}">
                        <Style TargetType="{x:Type avalonDock:LayoutAnchorableItem}">
                            <Setter Property="Title" Value="{Binding Model.Title}"/>
                            <Setter Property="ContentId" Value="{Binding Model.ContentId}" />
                        </Style>
                    </v:LayoutItemTypedStyle>
                </v:LayoutItemContainerStyleSelector>
            </avalonDock:DockingManager.LayoutItemContainerStyleSelector>

            <!-- ======== ウィンドウ内容のテンプレート ======== -->
            <avalonDock:DockingManager.LayoutItemTemplateSelector>
                <v:LayoutItemTemplateSelector>
                    <DataTemplate DataType="{x:Type local:ViewportVM}">
                        <local:Viewport/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type local:AssetBrowserVM}">
                        <local:AssetBrowser/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type local:HistoryWindowVM}">
                        <local:HistoryWindow/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type local:InspectorVM}">
                        <local:Inspector/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type local:LogListVM}">
                        <local:LogList/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type local:OutlinerVM}">
                        <local:Outliner/>
                    </DataTemplate>
                </v:LayoutItemTemplateSelector>
            </avalonDock:DockingManager.LayoutItemTemplateSelector>

            <!-- ======== デフォルトレイアウト ======== -->

            <!-- ContentId で識別される ViewModel を持つ LayoutAnchorable を、TargetLayoutName で識別される LayoutAnchorablePane に接続する -->
            <avalonDock:DockingManager.LayoutUpdateStrategy>
                <v:LayoutInitializer>
                    <v:LayoutInsertTarget ContentId="Outliner" TargetLayoutName="TopLeftSideArea" />
                    <v:LayoutInsertTarget ContentId="History" TargetLayoutName="TopRightSideArea" />
                    <v:LayoutInsertTarget ContentId="Inspector" TargetLayoutName="TopRightSideArea" />
                    <v:LayoutInsertTarget ContentId="Explorer" TargetLayoutName="BottomSide" />
                    <v:LayoutInsertTarget ContentId="LogList" TargetLayoutName="BottomSide" />
                </v:LayoutInitializer>
            </avalonDock:DockingManager.LayoutUpdateStrategy>

            <!-- 初期レイアウト -->
            <avalonDock:LayoutRoot>
                <avalonDock:LayoutPanel Orientation="Vertical" DockHeight="1000">

                    <avalonDock:LayoutPanel Orientation="Horizontal" DockHeight="700">
                        <avalonDock:LayoutAnchorablePane DockWidth="300" Name="TopLeftSideArea" />
                        <avalonDock:LayoutDocumentPane />
                        <avalonDock:LayoutAnchorablePane DockWidth="300" Name="TopRightSideArea" />
                    </avalonDock:LayoutPanel>

                    <avalonDock:LayoutAnchorablePane Name="BottomSide" DockHeight="300"/>

                </avalonDock:LayoutPanel>

            </avalonDock:LayoutRoot>

        </avalonDock:DockingManager>


    </DockPanel>
</Window>

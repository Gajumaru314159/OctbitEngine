<UserControl x:Class="OctbitEditor.LogList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OctbitEditor"
             xmlns:base="clr-namespace:CommonView;assembly=CommonView"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behavior="clr-namespace:CommonView.Behaviors;assembly=CommonView"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance local:LogListVM}">


    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Background="{DynamicResource Header}">
            <DockPanel.Resources>
                <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                    <Setter Property="Padding" Value="2,0"/>
                    <Setter Property="Margin" Value="0,0,1,0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="DockPanel.Dock" Value="Right"/>
                </Style>
                <Style x:Key="ButtonImage" TargetType="Image">
                    <Setter Property="Width" Value="14"/>
                    <Setter Property="Height" Value="14"/>
                    <Setter Property="Margin" Value="2,0,4,0"/>
                </Style>
            </DockPanel.Resources>
            <ToggleButton IsChecked="{Binding IsErrorLogFiltered.Value}" ToolTip="Error" Margin="0"  TabIndex="5">
                <DockPanel>
                    <ContentControl Style="{StaticResource Error}"/>
                    <TextBlock Text="{Binding ErrorLogCount.Value,FallbackValue=0}" HorizontalAlignment="Center" VerticalAlignment="Center"/>                    
                </DockPanel>
            </ToggleButton>
            <ToggleButton IsChecked="{Binding IsWarningLogFiltered.Value}" ToolTip="Warning" TabIndex="4">
                <DockPanel>
                    <ContentControl Style="{StaticResource Warning}"/>
                    <TextBlock Text="{Binding WarningLogCount.Value,FallbackValue=0}" HorizontalAlignment="Center"  VerticalAlignment="Center"/>
                </DockPanel>
            </ToggleButton>
            <ToggleButton IsChecked="{Binding IsInfoLogFiltered.Value}" ToolTip="Info" TabIndex="3">
                <DockPanel>
                    <ContentControl Style="{StaticResource Info}"/>
                    <TextBlock Text="{Binding InfoLogCount.Value,FallbackValue=0}" HorizontalAlignment="Center"  VerticalAlignment="Center"/>
                </DockPanel>
            </ToggleButton>

            <ToggleButton IsChecked="{Binding IsWarp.Value}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Width="32" TabIndex="2">
                <ContentControl Style="{StaticResource Wrap}" DockPanel.Dock="Right"/>
            </ToggleButton>

            <Button Content="Clear" Command="{Binding ClearCommand}" DockPanel.Dock="Right" Margin="0,0,1,0" TabIndex="1"/>

            <base:SearchBox Text="{Binding Filter.Value,Mode=TwoWay}" DockPanel.Dock="Right" TabIndex="0"/>
            
            <Border/>

        </DockPanel>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" MinHeight="10"/>
                <RowDefinition Height="1*" MinHeight="10"/>
            </Grid.RowDefinitions>
            <ListBox 
                TabIndex="6"
                ItemsSource="{Binding FilteredItems}" 
                SelectedItem="{Binding SelectedLogItem.Value}" 
                AlternationCount="2"
                Grid.Row="0"
                BorderThickness="0"
                ScrollViewer.HorizontalScrollBarVisibility="{Binding WarpVisibility.Value}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="Transparent">
                            <TextBlock Text="{Binding Message}" Foreground="{Binding Brush}" TextWrapping="Wrap"/>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Style.Triggers>
                            <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                                <Setter Property="Background" Value="Transparent"/>
                            </Trigger>
                            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                <Setter Property="Background" Value="#40000000" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
            <TextBox Grid.Row="1" Background="Transparent" BorderThickness="0" IsReadOnly="True"  TextWrapping="Wrap" 
                TabIndex="7"
                     VerticalAlignment="Stretch" VerticalContentAlignment="Top"
                     Text="{Binding SelectedLogMessage.Value}"/>


            <GridSplitter Grid.Row="1" Height="8" Margin="0,-4,0,0" VerticalAlignment="Top" HorizontalAlignment="Stretch" Focusable="False">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="{x:Type GridSplitter}">
                        <Border  Background="Transparent">
                            <Rectangle Fill="{DynamicResource Outline}" Height="1" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>
        </Grid>
    </DockPanel>
</UserControl>

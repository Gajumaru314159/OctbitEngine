<UserControl x:Class="OctbitEditor.Explorer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:OctbitEditor"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TreeView>
            <TreeViewItem Header="Scene">
                <TreeViewItem Header="Scene1"/>
                <TreeViewItem Header="Scene1"/>
                <TreeViewItem Header="Scene1"/>
                <TreeViewItem Header="Scene1"/>
            </TreeViewItem>
        </TreeView>

        <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Stretch"  BorderBrush="Transparent">
            <GridSplitter.Template>
                <ControlTemplate TargetType="GridSplitter">
                    <Border HorizontalAlignment="Center" MinWidth="40">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>

        <ListView Grid.Column="2">
            <ListViewItem>Materials</ListViewItem>
            <ListViewItem>Scenes</ListViewItem>
            <ListViewItem>Scripts</ListViewItem>
        </ListView>

    </Grid>
</UserControl>

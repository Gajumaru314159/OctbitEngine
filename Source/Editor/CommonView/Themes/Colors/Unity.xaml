<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:local="clr-namespace:CommonView"
                    >

    <sys:Double x:Key="DisableOpacity">0.5</sys:Double>

    <SolidColorBrush x:Key="Foreground" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="Background" Color="#383838"/>
    <SolidColorBrush x:Key="Surface" Color="#585858"/>
    <SolidColorBrush x:Key="Accent" Color="#46607C"/>
    <SolidColorBrush x:Key="AccentForeground" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="Field" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="Outline" Color="#626262"/>
    <SolidColorBrush x:Key="Header" Color="#3C3C3C"/>
    <SolidColorBrush x:Key="Focus" Color="#EEEEEE"/>
    <SolidColorBrush x:Key="MenuBackground" Color="#282828"/>
    <SolidColorBrush x:Key="Hover" Color="#20FFFFFF"/>
</ResourceDictionary>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:local="clr-namespace:CommonView"
                    >

    <sys:Double x:Key="DisableOpacity">0.5</sys:Double>

    <SolidColorBrush x:Key="Foreground" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="Background" Color="#444444"/>
    <SolidColorBrush x:Key="Surface" Color="#5E5E5E"/>
    <SolidColorBrush x:Key="Accent" Color="#5285A6"/>
    <SolidColorBrush x:Key="AccentForeground" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="Field" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="Outline" Color="#818181"/>
    <SolidColorBrush x:Key="Header" Color="#373737"/>
    <SolidColorBrush x:Key="Focus" Color="#EEEEEE"/>
    <SolidColorBrush x:Key="MenuBackground" Color="#444444"/>
    <SolidColorBrush x:Key="Hover" Color="#20FFFFFF"/>
</ResourceDictionary>
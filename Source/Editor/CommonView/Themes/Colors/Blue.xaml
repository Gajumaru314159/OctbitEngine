<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:local="clr-namespace:CommonView"
                    >

    <sys:Double x:Key="DisableOpacity">0.5</sys:Double>

    <SolidColorBrush x:Key="Foreground" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="Background" Color="#0D1F36"/>
    <SolidColorBrush x:Key="Surface" Color="#0D2A48"/>
    <SolidColorBrush x:Key="Accent" Color="#039A96"/>
    <SolidColorBrush x:Key="AccentForeground" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="Field" Color="#0C2039"/>
    <SolidColorBrush x:Key="Outline" Color="#051836"/>
    <SolidColorBrush x:Key="Header" Color="#0D1F36"/>
    <SolidColorBrush x:Key="Focus" Color="#EEEEEE"/>
    <SolidColorBrush x:Key="MenuBackground" Color="#0D1F36"/>
    <SolidColorBrush x:Key="Hover" Color="#20FFFFFF"/>
</ResourceDictionary>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:local="clr-namespace:CommonView"
                    >

    <sys:Double x:Key="DisableOpacity">0.5</sys:Double>

    <SolidColorBrush x:Key="Foreground" Color="#050505"/>
    <SolidColorBrush x:Key="Background" Color="#C8C8C8"/>
    <SolidColorBrush x:Key="Surface" Color="#E4E4E4"/>
    <SolidColorBrush x:Key="Accent" Color="#3A72B0"/>
    <SolidColorBrush x:Key="AccentForeground" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="Field" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="Outline" Color="#7F7F7F"/>
    <SolidColorBrush x:Key="Header" Color="#CFCFCF"/>
    <SolidColorBrush x:Key="Focus" Color="#050505"/>
    <SolidColorBrush x:Key="MenuBackground" Color="#8A8A8A"/>
    <SolidColorBrush x:Key="Hover" Color="#20000000"/>
</ResourceDictionary>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:local="clr-namespace:CommonView"
                    >

    <sys:Double x:Key="DisableOpacity">0.5</sys:Double>

    <SolidColorBrush x:Key="Foreground" Color="#EEEEEE"/>
    <SolidColorBrush x:Key="Background" Color="#383838"/>
    <SolidColorBrush x:Key="Surface" Color="#595959"/>
    <SolidColorBrush x:Key="Accent" Color="#5680C2"/>
    <SolidColorBrush x:Key="AccentForeground" Color="#EEEEEE"/>
    <SolidColorBrush x:Key="Field" Color="#232323"/>
    <SolidColorBrush x:Key="Outline" Color="#555555"/>
    <SolidColorBrush x:Key="Header" Color="#2D2D30"/>
    <SolidColorBrush x:Key="Focus" Color="#EEEEEE"/>
    <SolidColorBrush x:Key="MenuBackground" Color="#232323"/>
    <SolidColorBrush x:Key="Hover" Color="#20FFFFFF"/>
</ResourceDictionary>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:local="clr-namespace:CommonView"
                    >

    <sys:Double x:Key="DisableOpacity">0.5</sys:Double>

    <SolidColorBrush x:Key="Foreground" Color="#C0C0C0"/>
    <SolidColorBrush x:Key="Background" Color="#242424"/>
    <SolidColorBrush x:Key="Surface" Color="#353535"/>
    <SolidColorBrush x:Key="Accent" Color="#0070E0"/>
    <SolidColorBrush x:Key="AccentForeground" Color="#C0C0C0"/>
    <SolidColorBrush x:Key="Field" Color="#0F0F0F"/>
    <SolidColorBrush x:Key="Outline" Color="#404040"/>
    <SolidColorBrush x:Key="Header" Color="#303030"/>
    <SolidColorBrush x:Key="Focus" Color="#1080F0"/>
    <SolidColorBrush x:Key="MenuBackground" Color="#151515"/>
    <SolidColorBrush x:Key="Hover" Color="#20FFFFFF"/>
</ResourceDictionary>
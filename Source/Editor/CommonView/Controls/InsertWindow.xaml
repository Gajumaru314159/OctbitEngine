<UserControl x:Class="CommonView.Controls.InsertWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:forms="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms"
             Loaded="OnLoaded"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CommonView.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <WindowsFormsHost Background="{DynamicResource Background}" x:Name="m_host">
        <forms:Panel x:Name="m_panel" Click="OnClick"/>
    </WindowsFormsHost>
</UserControl>

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:behavior="clr-namespace:CommonView.Behaviors"
    xmlns:local="clr-namespace:CommonView">

    <Style TargetType="local:SearchBox">
        <Setter Property="Background" Value="{DynamicResource TextBoxBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Normal}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource TextBox.Outline.Normal}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Text" Value=""/>
        <Setter Property="Margin" Value="1"/>
        <Setter Property="Height" Value="Auto"/>
        <Setter Property="Width" Value="200"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:SearchBox">
                    <Border CornerRadius="4" 
                            Padding="4,0"
                            Height="{TemplateBinding Height}" 
                            Margin="{TemplateBinding Margin}" 
                            Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid Width="{TemplateBinding Width}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Source="/Resources/Icons/search.png" Height="12" Width="12" Margin="0,0,4,0" Grid.Column="0"/>
                            <TextBlock x:Name="waterMark" Text="{TemplateBinding Watermark}" Opacity="0.5" Grid.Column="1" Visibility="Collapsed" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Padding="0" Background="Transparent" BorderThickness="0" Grid.Column="1" VerticalAlignment="Center">
                                <i:Interaction.Behaviors>
                                    <behavior:EnterKeyBehavior/>
                                </i:Interaction.Behaviors>
                            </TextBox>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="waterMark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
</ResourceDictionary>

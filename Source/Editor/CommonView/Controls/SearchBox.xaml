<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:behavior="clr-namespace:CommonView.Behaviors"
    xmlns:local="clr-namespace:CommonView">

    <Style TargetType="{x:Type local:SearchBox}" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:SearchBox}">
                    <Border CornerRadius="{DynamicResource CornderRadiusA}" 
                            Padding="{TemplateBinding Padding}"
                            Height="{TemplateBinding Height}" 
                            Margin="{TemplateBinding Margin}" 
                            Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}">

                        <Grid MinWidth="{TemplateBinding MinWidth}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ContentControl Style="{StaticResource Search}" Foreground="{DynamicResource Foreground}" Margin="0,0,4,0" Grid.Column="0"/>
                            <TextBlock x:Name="waterMark" Text="{TemplateBinding Watermark}" Opacity="0.5" Grid.Column="1" Visibility="Collapsed" VerticalAlignment="Center"/>
                            <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="waterMark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{DynamicResource DisableOpacity}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="local:StyleBehaviorCollection.StyleBehaviors">
            <Setter.Value>
                <local:StyleBehaviorCollection>
                    <behavior:EnterKeyBehavior/>
                </local:StyleBehaviorCollection>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

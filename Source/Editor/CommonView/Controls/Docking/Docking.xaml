<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                    xmlns:local="clr-namespace:CommonView.Controls"
                    xmlns:behavior="clr-namespace:CommonView.Behaviors"
                    >

    <!--分割表示-->
    <DataTemplate DataType="{x:Type local:DockingTabGroup}">
        <TabControl ItemsSource="{Binding Items}"
                    ItemTemplate="{Binding ItemTemplate,RelativeSource={RelativeSource AncestorType=local:DockingLayout}}"
                    ItemTemplateSelector="{Binding ItemTemplateSelector,RelativeSource={RelativeSource AncestorType=local:DockingLayout}}"
                    ContentTemplate="{Binding ContentTemplate,RelativeSource={RelativeSource AncestorType=local:DockingLayout}}"
                    ContentTemplateSelector="{Binding ContentTemplateSelector,RelativeSource={RelativeSource AncestorType=local:DockingLayout}}"
                    Margin="1"
                    >
        </TabControl>
    </DataTemplate>

    <!--タブ表示-->
    <DataTemplate DataType="{x:Type local:DockingLayoutGroup}">
        <local:SplitControl ItemsSource="{Binding Items}" Orientation="{Binding Orientation.Value}"/>
    </DataTemplate>

    <!--ルートのドッキング-->
    <Style TargetType="local:DockingLayout">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:DockingLayout">
                    <ContentControl Content="{TemplateBinding Item}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
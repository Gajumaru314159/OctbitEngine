<ResourceDictionary
    x:Class="CommonView.Controls.InspectorResourceDictionary"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:common="clr-namespace:CommonView"
    xmlns:behavior="clr-namespace:CommonView.Behaviors"
    xmlns:ctrl="clr-namespace:CommonView.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/CommonView;component/Controls/Inspector/BuiltInInspectorIemTemplate.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <ctrl:InspectorItemDataSelector x:Key="InspectorItemDataSelector"/>
    <ctrl:InspectorControlDataSelector x:Key="InspectorControlDataSelector"/>

    <!--プロパティのラベル-->
    <DataTemplate x:Key="PropertyLabel" DataType="ctrl:InspectableObject">
        <DockPanel>
            <ToggleButton Content="✅"/>
            <TextBlock Text="{Binding Name}"/>
        </DockPanel>
    </DataTemplate>

    <!--子要素を持つ要素のラベル-->
    <DataTemplate x:Key="ObjectLabel" DataType="ctrl:">
        <DockPanel>
            <ToggleButton Content="✅"/>
            <TextBlock Text="{Binding Name}"/>
        </DockPanel>
    </DataTemplate>

    <DataTemplate x:Key="InspectablePropertyTemplate" DataType="ctrl:InspectableProperty">
        <ctrl:InspectorItemContainer Label="{Binding Name}">
            <ContentControl Content="{Binding}" IsEnabled="{Binding CanWrite}" ContentTemplateSelector="{StaticResource InspectorControlDataSelector}"/>
        </ctrl:InspectorItemContainer>
    </DataTemplate>

    <DataTemplate x:Key="InspectableObjectTemplate" DataType="ctrl:InspectableObject">
        <ctrl:InspectorView Label="{Binding Name}" ItemsSource="{Binding Inspectables}"/>
    </DataTemplate>

    <Style TargetType="ctrl:InspectorItemContainer">
        <Setter Property="Padding" Value="2"/>
        <Setter Property="Foreground" Value="{DynamicResource Foreground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Outline}"/>
        <Setter Property="Indent" Value="{Binding Indent,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ctrl:InspectorView}}"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ctrl:InspectorItemContainer">
                    <Grid MinHeight="22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <Grid x:Name="LabelBlock">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding Indent,RelativeSource={RelativeSource TemplatedParent}}"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <ContentControl x:Name="LabelControl" Grid.Column="1" Margin="{TemplateBinding Padding}"
                                        Content="{TemplateBinding Label}" IsTabStop="False" TextBlock.TextAlignment="Right"
                                        Foreground="{TemplateBinding Foreground}"/>
                        </Grid>


                        <ContentControl x:Name="ContentControl" Grid.Column="2" Margin="{TemplateBinding Padding}"
                                        Content="{TemplateBinding Content}" IsTabStop="False"/>

                        <Border x:Name="GridSplitter" Grid.Column="1" Width="1" HorizontalAlignment="Center" Background="{DynamicResource Outline}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="CollapseLabel" Value="True">
                            <Setter TargetName="GridSplitter" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="LabelControl" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="ContentControl" Property="Grid.Column" Value="0"/>
                            <Setter TargetName="ContentControl" Property="Grid.ColumnSpan" Value="3"/>
                            <Setter TargetName="ContentControl" Property="Margin" Value="0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style x:Key="InspectorExpandStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Foreground" Value="{DynamicResource Foreground}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="Border" Background="{TemplateBinding Background}">
                        <Border x:Name="Overlay">
                            <Grid Background="Transparent" SnapsToDevicePixels="False">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid>
                                    <Path x:Name="arrow" Data="{StaticResource ExpanderCloseArrow}" Stroke="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="false" StrokeThickness="1"/>
                                </Grid>
                                <ContentPresenter Grid.Column="1" Margin="{TemplateBinding Padding}" HorizontalAlignment="Stretch" VerticalAlignment="Center" RecognizesAccessKey="True" SnapsToDevicePixels="True" />
                            </Grid>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="true">
                            <Setter Property="Data" TargetName="arrow" Value="{StaticResource ExpanderOpenArrow}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{DynamicResource DisableOpacity}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ctrl:InspectorView">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Indent" Value="{Binding Indent,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ctrl:InspectorView},Converter={common:AddConverter},ConverterParameter=15,FallbackValue=0}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ctrl:InspectorView">
                    <StackPanel Orientation="Vertical">
                        <ctrl:InspectorItemContainer x:Name="Header" 
                                                     Indent="{Binding Indent,RelativeSource={RelativeSource TemplatedParent},Converter={common:AddConverter},ConverterParameter=-15}">
                            <ctrl:InspectorItemContainer.Label>
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton IsChecked="{Binding IsExpanded,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}" Style="{StaticResource InspectorExpandStyle}">
                                        <TextBlock Text="{TemplateBinding Label}" TextAlignment="Left"/>
                                    </ToggleButton>
                                </StackPanel>
                            </ctrl:InspectorItemContainer.Label>
                        </ctrl:InspectorItemContainer>
                        <Grid>
                            <Border x:Name="Border" BorderBrush="{DynamicResource Outline}" BorderThickness="1,0,0,0">
                                <Border.RenderTransform>
                                    <TranslateTransform X="{Binding Indent,RelativeSource={RelativeSource TemplatedParent},Converter={common:AddConverter},ConverterParameter=-7}"/>
                                </Border.RenderTransform>
                            </Border>
                            <ItemsPresenter x:Name="Items"/>
                        </Grid>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Indent" Value="0">
                            <Setter TargetName="Border" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Label" Value="{x:Null}">
                            <Setter TargetName="Header" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="Items" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemTemplateSelector" Value="{StaticResource InspectorItemDataSelector}"/>
    </Style>


    <Style TargetType="ctrl:InspectorView" x:Key="ToLevelnspector">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ctrl:InspectorView">
                    <StackPanel Orientation="Vertical">
                        <ctrl:InspectorItemContainer x:Name="Header">
                            <ctrl:InspectorItemContainer.Label>
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton IsChecked="{Binding IsExpanded,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}" Style="{StaticResource InspectorExpandStyle}">
                                        <TextBlock Text="{TemplateBinding Label}" TextAlignment="Left"/>
                                    </ToggleButton>
                                </StackPanel>
                            </ctrl:InspectorItemContainer.Label>
                        </ctrl:InspectorItemContainer>
                        <Grid>
                            <ItemsPresenter x:Name="Items"/>
                        </Grid>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Label" Value="{x:Null}">
                            <Setter TargetName="Header" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="Items" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemTemplateSelector" Value="{StaticResource InspectorItemDataSelector}"/>
    </Style>

</ResourceDictionary>

<ResourceDictionary
    x:Class="CommonView.Controls.InspectorResourceDictionary"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:behavior="clr-namespace:CommonView.Behaviors"
    xmlns:ctrl="clr-namespace:CommonView.Controls">

    <!--プロパティのラベル-->
    <DataTemplate x:Key="PropertyLabel" DataType="ctrl:InspectableObject">
        <DockPanel>
            <ToggleButton Content="✅"/>
            <TextBlock Text="{Binding Name}"/>
        </DockPanel>
    </DataTemplate>

    <!--子要素を持つ要素のラベル-->
    <DataTemplate x:Key="ObjectLabel" DataType="ctrl:InspectableObject">
        <DockPanel>
            <ToggleButton Content="✅"/>
            <TextBlock Text="{Binding Name}"/>
        </DockPanel>
    </DataTemplate>

    <Style x:Key="ExpanderToggle" TargetType="ToggleButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent" SnapsToDevicePixels="False" Width="10">
                        <Grid.LayoutTransform>
                            <TransformGroup>
                                <TransformGroup.Children>
                                    <TransformCollection>
                                        <RotateTransform Angle="180"/>
                                    </TransformCollection>
                                </TransformGroup.Children>
                            </TransformGroup>
                        </Grid.LayoutTransform>
                        <Path x:Name="arrow" Data="M 4.5,7 L 1,3.5 L 4.5,0" Stroke="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="false" StrokeThickness="1"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Data" TargetName="arrow" Value="M 1,4.5  L 4.5,1  L 8,4.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style TargetType="ctrl:InspectorItemContainer">
        <Setter Property="Padding" Value="2"/>
        <Setter Property="Foreground" Value="{DynamicResource Foreground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Outline}"/>
        <Setter Property="Indent" Value="{Binding Indent,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ctrl:InspectorView,AncestorLevel=1}}"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ctrl:InspectorItemContainer">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <Grid x:Name="LabelBlock">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding Indent,RelativeSource={RelativeSource TemplatedParent}}"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="Indent" BorderBrush="{DynamicResource Foreground}" Opacity="0.2" BorderThickness="0,0,1,0">
                                <Border.RenderTransform>
                                    <TranslateTransform X="-7"/>
                                </Border.RenderTransform>
                            </Border>

                            <ToggleButton x:Name="IsExpanded" Grid.Column="1" 
                                      Style="{StaticResource ExpanderToggle}" Foreground="{TemplateBinding Foreground}" 
                                      IsChecked="{Binding IsExpanded,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}"/>

                            <ContentControl x:Name="LabelControl" Grid.Column="2" Margin="{TemplateBinding Padding}"
                                        Content="{TemplateBinding Label}" IsTabStop="False"
                                        Foreground="{TemplateBinding Foreground}"/>
                        </Grid>


                        <ContentControl x:Name="ContentControl" Grid.Column="2" Margin="{TemplateBinding Padding}"
                                        Content="{TemplateBinding Content}" IsTabStop="False"/>

                        <Border Grid.Column="1" Width="1" x:Name="GridSplitter" HorizontalAlignment="Center" Background="{DynamicResource Outline}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="CollapseLabel" Value="True">
                            <Setter TargetName="LabelControl" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="ContentControl" Property="Grid.Column" Value="0"/>
                            <Setter TargetName="ContentControl" Property="Grid.ColumnSpan" Value="3"/>
                            <Setter TargetName="ContentControl" Property="Margin" Value="0"/>
                            <!--<Setter TargetName="SplitterControl" Property="Visibility" Value="Collapsed"/>-->
                        </Trigger>
                        <Trigger Property="IsExpanded" Value="{x:Null}">
                            <Setter TargetName="IsExpanded" Property="Visibility" Value="Hidden"/>
                            <Setter TargetName="LabelControl" Property="TextBlock.TextAlignment" Value="Right"/>
                        </Trigger>
                        <Trigger Property="Indent" Value="0">
                            <Setter TargetName="Indent" Property="BorderBrush" Value="Transparent"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ctrl:InspectorView">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ctrl:InspectorView">
                    <ItemsPresenter/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
